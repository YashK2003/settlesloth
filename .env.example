# ==============================================================================
# SettleSloth - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: SettleSloth is 100% functional out-of-the-box without any API keys
# using its built-in deterministic local fallback engine.
# ==============================================================================

# Server listening port (default: 3000)
PORT=3000

# Optional: Google AI Studio API key for cloud Gemma 3 inference
# Obtain a free key at https://aistudio.google.com/app/apikey
# Leave empty to use local Ollama or the deterministic local parser
GEMINI_API_KEY=

# Gemma model identifier in Google AI Studio (default: gemma-4-26b-a4b-it)
# Supported hosted models: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Request timeout for hosted Google AI Studio requests in milliseconds (default: 90000)
GEMINI_TIMEOUT_MS=90000

# Optional: Local Ollama inference configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
